# Cosy Pocket Builder - Environment Variables
# 
# This file contains example environment variables for local development.
# Copy this file to .env.local and fill in your actual values.
# 
# NEVER commit .env.local to version control!
# Add .env.local to .gitignore

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection string for production
# Use PGLite for local development (no configuration needed)
# 
# Format: postgresql://user:password@host:port/database?options
# 
# Recommended providers:
# - Neon: https://neon.tech (serverless Postgres)
# - Supabase: https://supabase.com
# - AWS RDS: https://aws.amazon.com/rds/postgresql/
# - Local: postgresql://user:password@localhost:5432/cozy
#
DATABASE_URL=

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Enable/disable authentication
# Set to "true" to enable Better Auth with OAuth providers
# Set to "false" for dev-only mode (no database, no sign-in)
VITE_AUTH_ENABLED=false

# Grok Auth Broker configuration
# Use the shared preview client for local development
# Get your own credentials from https://grok.com for production
GROK_AUTH_ISSUER=https://auth.grok.me
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# Better Auth session signing secret
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Better Auth base URL (optional)
# Auto-detected in most cases
# Set explicitly if needed (e.g., for custom domains)
BETTER_AUTH_URL=

# =============================================================================
# AI GENERATION
# =============================================================================
# xAI API key for Grok AI
# Get from: https://console.x.ai
XAI_API_KEY=

# Access token for generation rate limiting
# Optional: only needed if you want to enforce rate limits
GENERATE_ACCESS_TOKEN=

# Rate limiting configuration (optional)
# Default: 10 requests/minute/IP, 100 requests/day/IP
GENERATE_RATE_LIMIT_MIN=10
GENERATE_RATE_LIMIT_DAY=100

# =============================================================================
# APPLICATION
# =============================================================================
# App name (used in PWA manifest)
# Default: "Cozy AI Studio"
VITE_APP_NAME=Cozy Pocket Builder

# App description
VITE_APP_DESCRIPTION=Generate and deploy beautiful web apps from natural language

# Theme color (hex)
# Default: #12110f (dark paper)
VITE_THEME_COLOR=#12110f

# =============================================================================
# DEVELOPMENT
# =============================================================================
# Development server port
# Default: 8080
# Note: Changing this may require updates to other configurations
VITE_DEV_PORT=8080

# Development server host
# Default: 0.0.0.0 (all interfaces)
VITE_DEV_HOST=0.0.0.0
